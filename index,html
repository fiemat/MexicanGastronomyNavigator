            "region": "Guanajuato (Irapuato) / Nationwide",
            "spice": "Sweet & Creamy",
            "pronunciation": "FREH-sahs kohn KREH-mah",
            "description": "Chilled sweet street cup packed with ripe sliced fresh strawberries layered with sweetened whipped heavy cream, evaporated milk, and condensed milk.",
            "howToEat": "Topped with toasted coconut, chopped pecans, or raisins and eaten with a spoon."
          },
          {
            "id": 1015,
            "dish": "Agua de Horchata de Melón",
            "category": "drinks",
            "categoryName": "Cocktails & Beverages",
            "region": "Sonora & Sinaloa",
            "spice": "No Spice / Sweet Melon",
            "pronunciation": "AH-gwah deh ohr-CHAH-tah deh meh-LOHN",
            "description": "Refreshing Sonoran summer drink made by blending cantaloupe melon seeds and fruit pulp with rice milk, cinnamon, and vanilla.",
            "howToEat": "Served over crushed ice in large street cups."
          },
          {
            "id": 1016,
            "dish": "Biónico",
            "category": "antojitos",
            "categoryName": "Tacos & Street Eats",
            "region": "Jalisco (Guadalajara)",
            "spice": "Sweet & Creamy",
            "pronunciation": "bee-OH-nee-koh",
            "description": "Guadalajara's famous street fruit bowl packed with chopped papaya, cantaloupe, honeydew, banana, apple, and strawberries drenched in a house sweet cream sauce.",
            "howToEat": "Topped generously with granola, shredded coconut, raisins, and honey."
          }
        ];

        const normalizeStr = (str) => {
          return (str || '').normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
        };

        const isFavorite = (id) => favorites.value.includes(id);

        const toggleFavorite = (id) => {
          if (isFavorite(id)) {
            favorites.value = favorites.value.filter(fId => fId !== id);
            triggerToast('Removed from Saved Favorites');
          } else {
            favorites.value.push(id);
            triggerToast('Saved to Favorites! ❤️');
          }
        };

        const hasCardStructuredMeta = (item) => {
          return Boolean(item.baseSpirit || item.usEquivalent || item.category === 'chiles');
        };

        const activeRefinementCount = computed(() => {
          let count = 0;
          if (selectedRegion.value) count++;
          if (selectedSpice.value) count++;
          if (selectedDietary.value) count++;
          if (selectedMealTime.value) count++;
          return count;
        });

        const hasAnyActiveFilter = computed(() => {
          return Boolean(
            searchQuery.value.trim() ||
            activeCategory.value !== 'all' ||
            selectedRegion.value ||
            selectedSpice.value ||
            selectedDietary.value ||
            selectedMealTime.value ||
            showFavoritesOnly.value
          );
        });

        const dietaryLabels = {
          vegetarian: 'Vegetarian',
          gluten_free: 'Gluten-Free',
          dairy_free: 'Dairy-Free',
          nut_free: 'Nut-Free'
        };

        const mealTimeLabels = {
          breakfast: 'Morning / Breakfast',
          night: 'Late Night Street Eats'
        };

        const activeFilterPills = computed(() => {
          const pills = [];
          if (searchQuery.value.trim()) {
            pills.push({
              key: 'search',
              label: `Search: "${searchQuery.value.trim()}"`,
              clear: () => { searchQuery.value = ''; }
            });
          }
          if (activeCategory.value !== 'all') {
            const catObj = categories.find(c => c.id === activeCategory.value);
            pills.push({
              key: 'category',
              label: `Category: ${catObj ? catObj.name : activeCategory.value}`,
              clear: () => { activeCategory.value = 'all'; }
            });
          }
          if (selectedRegion.value) {
            pills.push({
              key: 'region',
              label: `Region: ${selectedRegion.value}`,
              clear: () => { selectedRegion.value = ''; }
            });
          }
          if (selectedSpice.value) {
            pills.push({
              key: 'spice',
              label: `Heat: ${selectedSpice.value}`,
              clear: () => { selectedSpice.value = ''; }
            });
          }
          if (selectedDietary.value) {
            pills.push({
              key: 'dietary',
              label: `Dietary: ${dietaryLabels[selectedDietary.value] || selectedDietary.value}`,
              clear: () => { selectedDietary.value = ''; }
            });
          }
          if (selectedMealTime.value) {
            pills.push({
              key: 'mealTime',
              label: `Meal Time: ${mealTimeLabels[selectedMealTime.value] || selectedMealTime.value}`,
              clear: () => { selectedMealTime.value = ''; }
            });
          }
          if (showFavoritesOnly.value) {
            pills.push({
              key: 'favorites',
              label: 'Saved Favorites Only',
              clear: () => { showFavoritesOnly.value = false; }
            });
          }
          return pills;
        });

        const applyQuickSuggestion = (term) => {
          resetFilters();
          searchQuery.value = term;
        };

        const resetFilters = () => {
          searchQuery.value = '';
          activeCategory.value = 'all';
          selectedRegion.value = '';
          selectedSpice.value = '';
          selectedDietary.value = '';
          selectedMealTime.value = '';
          showFavoritesOnly.value = false;
        };

        const recentlyViewed = ref([]);

        const openModal = (item) => {
          activeModalItem.value = item;
          // Reset accordions on open for clean progressive disclosure
          modalAccordions.taquero = false;
          modalAccordions.tipping = false;
          modalAccordions.pairings = false;
          if (item) {
            recentlyViewed.value = [item, ...recentlyViewed.value.filter(i => i.id !== item.id)].slice(0, 5);
          }
        };

        const copyOrderPhrase = (phrase) => {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(phrase).then(() => {
              triggerToast('Spanish phrase copied to clipboard!');
            }).catch(() => {
              fallbackCopyText(phrase);
            });
          } else {
            fallbackCopyText(phrase);
          }
        };

        const fallbackCopyText = (text) => {
          const textArea = document.createElement('textarea');
          textArea.value = text;
          textArea.style.position = 'fixed';
          textArea.style.opacity = '0';
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          try {
            document.execCommand('copy');
            triggerToast('Spanish phrase copied to clipboard!');
          } catch (err) {
            triggerToast('Select the phrase above to copy.');
          }
          document.body.removeChild(textArea);
        };

        const getSpiceBadgeClass = (spice) => {
          if (!spice) return 'bg-purple-900/60 text-purple-200 border border-purple-700/50';
          const s = spice.toLowerCase();
          if (s.includes('no spice') || s.includes('basic')) return 'bg-emerald-950 text-emerald-300 border border-emerald-700/60';
          if (s.includes('mild')) return 'bg-amber-950 text-amber-300 border border-amber-700/60';
          if (s.includes('moderate')) return 'bg-orange-950 text-orange-300 border border-orange-700/60';
          if (s.includes('spicy') || s.includes('hot')) return 'bg-red-950 text-red-300 border border-red-700/60';
          return 'bg-fuchsia-950 text-fuchsia-300 border border-fuchsia-700/60';
        };

        // 7. Refactored Search Filtering (explicit normalized field matching instead of JSON.stringify)
        const filteredItems = computed(() => {
          const q = normalizeStr(searchQuery.value.trim());

          return masterItems.filter(item => {
            if (activeCategory.value !== 'all') {
              if (activeCategory.value === 'tacos_street') {
                if (item.category !== 'antojitos' && item.category !== 'meats' && !item.dish.toLowerCase().includes('taco')) return false;
              } else if (activeCategory.value === 'meats') {
                if (item.category !== 'meats' && !item.usEquivalent && !item.dish.toLowerCase().includes('carne')) return false;
              } else if (activeCategory.value === 'chiles_ingredients') {
                if (item.category !== 'chiles' && item.category !== 'ingredients') return false;
              } else if (item.category !== activeCategory.value) {
                return false;
              }
            }

            if (selectedRegion.value) {
              const regTarget = selectedRegion.value.toLowerCase();
              const itemReg = (item.region || '').toLowerCase();
              
              if (regTarget.includes('jalisco')) {
                if (!itemReg.includes('jalisco') && !itemReg.includes('western') && !itemReg.includes('colima') && !itemReg.includes('nayarit')) return false;
              } else if (regTarget.includes('yucatán')) {
                if (!itemReg.includes('yucatán') && !itemReg.includes('mayan') && !itemReg.includes('motul')) return false;
              } else if (regTarget.includes('puebla')) {
                if (!itemReg.includes('puebla') && !itemReg.includes('hidalgo') && !itemReg.includes('morelos') && !itemReg.includes('tlaxcala')) return false;
              } else if (regTarget.includes('northern') || regTarget.includes('baja')) {
                if (!itemReg.includes('north') && !itemReg.includes('sonora') && !itemReg.includes('sinaloa') && !itemReg.includes('baja') && !itemReg.includes('chihuahua') && !itemReg.includes('durango') && !itemReg.includes('coahuila') && !itemReg.includes('nuevo león')) return false;
              } else if (regTarget.includes('mexico city') || regTarget.includes('central')) {
                if (!itemReg.includes('mexico city') && !itemReg.includes('cdmx') && !itemReg.includes('central') && !itemReg.includes('state of mexico') && !itemReg.includes('toluca')) return false;
              } else if (regTarget.includes('michoacán')) {
                if (!itemReg.includes('michoacán') && !itemReg.includes('guanajuato') && !itemReg.includes('zamora') && !itemReg.includes('uruapan') && !itemReg.includes('pátzcuaro')) return false;
              } else if (regTarget.includes('veracruz')) {
                if (!itemReg.includes('veracruz') && !itemReg.includes('huasteca') && !itemReg.includes('xico')) return false;
              } else if (regTarget.includes('chiapas') || regTarget.includes('guerrero')) {
                if (!itemReg.includes('chiapas') && !itemReg.includes('guerrero') && !itemReg.includes('taxco') && !itemReg.includes('san cristóbal')) return false;
              } else if (regTarget.includes('oaxaca')) {
                if (!itemReg.includes('oaxaca')) return false;
              } else if (regTarget.includes('nationwide')) {
                if (!itemReg.includes('nationwide') && !itemReg.includes('coasts') && !itemReg.includes('global')) return false;
              } else {
                if (!itemReg.includes(regTarget)) return false;
              }
            }

            if (selectedDietary.value) {
              const target = selectedDietary.value;
              const cat = item.category;
              const dishLower = item.dish.toLowerCase();
              const descLower = item.description.toLowerCase();
              
              if (target === 'gluten_free') {
                if (dishLower.includes('gringa') || dishLower.includes('paste') || dishLower.includes('burrito') || dishLower.includes('fideo')) return false;
              } else if (target === 'vegetarian') {
                if (cat === 'meats') return false;
                if (descLower.includes('pork') || descLower.includes('beef') || descLower.includes('chicken') || descLower.includes('lard') || descLower.includes('shrimp') || descLower.includes('fish') || descLower.includes('octopus') || descLower.includes('lamb') || descLower.includes('goat') || descLower.includes('suadero') || descLower.includes('carnitas') || descLower.includes('barbacoa')) return false;
              } else if (target === 'dairy_free') {
                if (descLower.includes('cheese') || descLower.includes('queso') || descLower.includes('crema') || descLower.includes('milk') || descLower.includes('butter')) return false;
              } else if (target === 'nut_free') {
                if (descLower.includes('peanut') || descLower.includes('cacahuate') || descLower.includes('almond') || descLower.includes('hazelnut') || descLower.includes('mole poblano') || descLower.includes('mazapán')) return false;
              }
            }

            if (selectedMealTime.value) {
              const mt = selectedMealTime.value;
              const dishLower = item.dish.toLowerCase();
              const descLower = item.description.toLowerCase();
              if (mt === 'breakfast') {
                if (!descLower.includes('breakfast') && !descLower.includes('egg') && !descLower.includes('huevo') && !descLower.includes('tamal') && !descLower.includes('atole') && !descLower.includes('chilaquiles') && !descLower.includes('guajolota') && !descLower.includes('mollete')) return false;
              } else if (mt === 'night') {
                if (!dishLower.includes('taco') && !dishLower.includes('pastor') && !dishLower.includes('suadero') && !dishLower.includes('marquesita') && !dishLower.includes('gringa') && !dishLower.includes('churro') && !dishLower.includes('cantarito') && !dishLower.includes('margarita')) return false;
              }
            }

            if (selectedSpice.value) {
              const itemSpice = (item.spice || '').toLowerCase();
              const target = selectedSpice.value.toLowerCase();
              if (target === 'no spice' && !itemSpice.includes('no spice') && !itemSpice.includes('basic')) return false;
              if (target === 'mild' && !itemSpice.includes('mild')) return false;
              if (target === 'moderate' && !itemSpice.includes('moderate')) return false;
              if (target === 'spicy' && !itemSpice.includes('spicy') && !itemSpice.includes('hot')) return false;
              if (target === 'extra hot' && !itemSpice.includes('extra hot') && !itemSpice.includes('fiery')) return false;
            }

            if (showFavoritesOnly.value && !isFavorite(item.id)) {
              return false;
            }

            if (q !== '') {
              const matchesSearch =
                normalizeStr(item.dish).includes(q) ||
                normalizeStr(item.description).includes(q) ||
                normalizeStr(item.region).includes(q) ||
                normalizeStr(item.categoryName).includes(q) ||
                normalizeStr(item.baseSpirit).includes(q) ||
                normalizeStr(item.usEquivalent).includes(q) ||
                normalizeStr(item.howToEat).includes(q);
              if (!matchesSearch) return false;
            }

            return true;
          }).sort((a, b) => a.dish.localeCompare(b.dish, 'es', { sensitivity: 'base' }));
        });

        // 5. Audio Pronunciation with Active Playback Feedback State
        const speakPronunciation = (text, itemId) => {
          if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const cleanText = text.split('(')[0].trim();
            const utterance = new SpeechSynthesisUtterance(cleanText);
            utterance.lang = 'es-MX';
            utterance.rate = 0.9;
            utterance.onstart = () => {
              speakingItemId.value = itemId;
            };
            utterance.onend = () => {
              speakingItemId.value = null;
            };
            utterance.onerror = () => {
              speakingItemId.value = null;
            };
            window.speechSynthesis.speak(utterance);
          } else {
            triggerToast('Audio pronunciation is not supported on this browser.');
          }
        };

        const getTippingSuggestion = (item) => {
          if (!item) return '';
          if (item.category === 'tacos_street' || item.category === 'antojitos') {
            return '🌮 Street Carts & Fondas: 5–10 pesos loose cash change per order or 10% for sit-down fonda service.';
          } else if (item.category === 'drinks') {
            return '🍹 Bars & Cocktail Lounges: 10%–15% on the tab, or 10–20 pesos per drink at casual stand-up bars.';
          } else if (item.category === 'meats' || item.category === 'soups') {
            return '🍽️ Casual Restaurants & Fondas: 10% is standard; 15% for exceptional sit-down service.';
          } else {
            return '💵 General Tipping: 10% for sit-down dining, optional change jar at market stalls.';
          }
        };

        const getTaqueroPhrase = (item) => {
          if (!item) return '';
          const name = item.dish.split('(')[0].trim();
          if (item.category === 'drinks') {
            return `Un(a) ${name} bien frío(a), por favor.`;
          } else if (item.category === 'meats') {
            return `Un taco de ${name} con todo, por favor.`;
          } else if (item.category === 'soups') {
            return `Un plato de ${name} bien caliente, por favor.`;
          } else if (item.category === 'chiles' || item.category === 'ingredients') {
            return `¿Me das ${name} por separado, por favor?`;
          } else {
            return `Un(a) ${name} con todo, por favor.`;
          }
        };

        const exportFavorites = () => {
          if (favorites.value.length === 0) {
            triggerToast('No saved favorites to export yet!');
            return;
          }
          const favItems = masterItems.filter(i => favorites.value.includes(i.id));
          const textContent = "🪅 MEXICAN GASTRONOMY NAVIGATOR - MY SAVED FAVORITES 🪅\n\n" + 
            favItems.map(i => `• ${i.dish} (${i.categoryName})\n  Region: ${i.region || 'Nationwide'}\n  Description: ${i.description}\n  Spanish Order: "${getTaqueroPhrase(i)}"\n`).join('\n');
          
          const blob = new Blob([textContent], { type: 'text/plain;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.setAttribute('download', 'My_Mexican_Food_Favorites.txt');
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
          triggerToast(`Exported ${favItems.length} saved favorites!`);
        };

        return {
          searchQuery,
          activeCategory,
          selectedRegion,
          selectedSpice,
          selectedDietary,
          selectedMealTime,
          showFavoritesOnly,
          showAdvancedFilters,
          showGuidesDropdown,
          guidesDropdownRef,
          openGuideModal,
          favorites,
          activeModalItem,
          showBeefGuideModal,
          showNativeGuideModal,
          showEtiquetteModal,
          modalAccordions,
          toggleAccordion,
          speakingItemId,
          toastMessage,
          speakPronunciation,
          exportFavorites,
          beefComparisonTable,
          masterItems,
          quickKeywords,
          categories,
          regionsList,
          filteredItems,
          activeRefinementCount,
          hasAnyActiveFilter,
          activeFilterPills,
          applyQuickSuggestion,
          hasCardStructuredMeta,
          isFavorite,
          toggleFavorite,
          resetFilters,
          openModal,
          getTaqueroPhrase,
          getTippingSuggestion,
          recentlyViewed,
          copyOrderPhrase,
          getSpiceBadgeClass
        };
      }
    }).mount('#app');
  </script>
</body>
